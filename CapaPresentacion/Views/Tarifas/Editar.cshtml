@model CapaPresentacion.ViewModels.TarifasTemporadaViewModel
@{
    ViewBag.Titulo = "Precios de temporada";
}
<h1>Precios: @Model.NombreTemporada.</h1>
<p class="sub">@Model.Rango. Precio por noche, en soles. Deja un campo vacío para dejar ese tipo sin tarifa.</p>

<div class="card form">
    @using (Html.BeginForm("Guardar", "Tarifas", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.IdTemporada)
        @Html.ValidationSummary(true)

        for (int i = 0; i < Model.Items.Count; i++)
        {
            @Html.HiddenFor(m => m.Items[i].IdTipoHabitacion)
            @Html.HiddenFor(m => m.Items[i].NombreTipo)

            <label for="Items_@(i)__Precio">@Model.Items[i].NombreTipo (S/ por noche)</label>
            @Html.TextBoxFor(m => m.Items[i].Precio, new { @class = "inp", type = "number", step = "0.01", min = "0.01", max = "99999.99", inputmode = "decimal" })
            @Html.ValidationMessageFor(m => m.Items[i].Precio)
        }

        <div class="botones">
            <button type="submit" class="btn-p">Guardar precios</button>
            <a class="btn-s" href="@Url.Action("Index")">Cancelar</a>
        </div>
    }
</div>