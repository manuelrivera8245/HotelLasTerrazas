@model CapaPresentacion.ViewModels.RegistroViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Crear cuenta · Las Terrazas</title>
    <link href="@CapaPresentacion.Helpers.EstiloHelper.Hotel()" rel="stylesheet" />
</head>
<body>
    <div class="login-wrap">
        <div class="login-card">
            <section class="login-brand">
                <div class="logo">LT<span><b>LAS TERRAZAS</b><small>HOTEL · AREQUIPA</small></span></div>
                <div>
                    <div class="eyebrow">TU PRIMERA RESERVA</div>
                    <h1>Reserva en minutos.</h1>
                    <p>Crea tu cuenta, elige tus fechas y consulta la disponibilidad real del hotel, sin llamadas ni esperas.</p>
                </div>
                <small>Gestión de hospedaje · Avance académico</small>
            </section>

            <section class="login-form">
                <div class="eyebrow">CREA TU CUENTA</div>
                <h2>Bienvenido</h2>
                <p class="sub">Los campos con * son obligatorios.</p>

                @using (Html.BeginForm("Registro", "Cuenta", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true)

                    <div class="fila2">
                        <div>
                            @Html.LabelFor(m => m.Nombres)
                            @Html.TextBoxFor(m => m.Nombres, new { @class = "inp", maxlength = 80, autofocus = "autofocus", autocomplete = "given-name" })
                            @Html.ValidationMessageFor(m => m.Nombres)
                        </div>
                        <div>
                            @Html.LabelFor(m => m.Apellidos)
                            @Html.TextBoxFor(m => m.Apellidos, new { @class = "inp", maxlength = 80, autocomplete = "family-name" })
                            @Html.ValidationMessageFor(m => m.Apellidos)
                        </div>
                    </div>

                    <div class="fila2">
                        <div>
                            @Html.LabelFor(m => m.TipoDocumento)
                            @Html.DropDownListFor(m => m.TipoDocumento, Model.Tipos, new { @class = "inp" })
                            @Html.ValidationMessageFor(m => m.TipoDocumento)
                        </div>
                        <div>
                            @Html.LabelFor(m => m.NumeroDocumento)
                            @Html.TextBoxFor(m => m.NumeroDocumento, new { @class = "inp", maxlength = 12, autocomplete = "off" })
                            @Html.ValidationMessageFor(m => m.NumeroDocumento)
                        </div>
                    </div>
                    <small class="ayuda" id="ayudaDoc"></small>

                    @Html.LabelFor(m => m.Correo)
                    @Html.TextBoxFor(m => m.Correo, new { @class = "inp", maxlength = 50, type = "email", autocomplete = "username" })
                    @Html.ValidationMessageFor(m => m.Correo)

                    @Html.LabelFor(m => m.Telefono)
                    @Html.TextBoxFor(m => m.Telefono, new { @class = "inp", maxlength = 20, type = "tel", autocomplete = "tel" })
                    @Html.ValidationMessageFor(m => m.Telefono)

                    <div class="fila2">
                        <div>
                            @Html.LabelFor(m => m.Clave)
                            @Html.PasswordFor(m => m.Clave, new { @class = "inp", autocomplete = "new-password" })
                            @Html.ValidationMessageFor(m => m.Clave)
                        </div>
                        <div>
                            @Html.LabelFor(m => m.ConfirmarClave)
                            @Html.PasswordFor(m => m.ConfirmarClave, new { @class = "inp", autocomplete = "new-password" })
                            @Html.ValidationMessageFor(m => m.ConfirmarClave)
                        </div>
                    </div>
                    <small class="ayuda">Mínimo 8 caracteres, combinando letras y números.</small>

                    <button type="submit" class="btn-main">Crear cuenta →</button>
                }

                <p class="enlaces">
                    ¿Ya tienes cuenta? <a href="@Url.Action("Login", "Cuenta")">Inicia sesión</a>
                    · <a href="@Url.Action("Index", "Inicio")">Volver al inicio</a>
                </p>
            </section>
        </div>
    </div>

    <script>
        (function () {
            const tipo = document.getElementById('TipoDocumento');
            const ayuda = document.getElementById('ayudaDoc');
            if (!tipo || !ayuda) return;
            const textos = {
                DNI: 'DNI: 8 dígitos.',
                CE: 'Carné de extranjería: de 9 a 12 letras o números.',
                Pasaporte: 'Pasaporte: de 6 a 12 letras o números.'
            };
            function mostrar() { ayuda.textContent = textos[tipo.value] || ''; }
            tipo.addEventListener('change', mostrar);
            mostrar();
        })();
    </script>
</body>
</html>