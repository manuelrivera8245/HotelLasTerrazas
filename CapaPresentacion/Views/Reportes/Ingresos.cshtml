@model CapaNegocio.ReporteIngresos
@using System.Globalization
@{
    ViewBag.Titulo = "Reporte de ingresos";
    var inv = CultureInfo.InvariantCulture;
}
<div class="cabecera">
    <div>
        <h1>Ingresos.</h1>
        <p class="sub">Pagos registrados del @Model.Desde.ToString("dd/MM/yyyy") al @Model.Hasta.ToString("dd/MM/yyyy").</p>
    </div>
    <a class="btn-s no-print" href="@Url.Action("Index")">← Reportes</a>
</div>

<div class="card no-print" style="margin-bottom:16px">
    <form method="get" action="@Url.Action("Ingresos")" class="filtros">
        <div>
            <label for="desde">Desde</label>
            <input class="inp" type="date" id="desde" name="desde" value="@Model.Desde.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label for="hasta">Hasta</label>
            <input class="inp" type="date" id="hasta" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn-p">Generar</button>
        <button type="button" class="btn-s" onclick="window.print()">Imprimir / PDF</button>
    </form>
</div>

@if (Model.Error != null)
{
    <div class="warn">@Model.Error</div>
}
else if (Model.CantPagos == 0)
{
    <div class="card">No hay pagos registrados en ese rango.</div>
}
else
{
    <div class="kpis">
        <div class="card kpi"><small>Total cobrado</small><b>S/ @Model.Total.ToString("N2", inv)</b></div>
        <div class="card kpi"><small>Pagos registrados</small><b>@Model.CantPagos</b></div>
        <div class="card kpi"><small>Pago promedio</small><b>S/ @Model.Promedio.ToString("N2", inv)</b></div>
    </div>

    <div class="dos">
        <div class="card tabla">
            <table>
                <thead><tr><th>MÉTODO</th><th>PAGOS</th><th>MONTO</th><th>%</th></tr></thead>
                <tbody>
                    @foreach (var m in Model.PorMetodo)
                    {
                        int w = (int)Math.Round((double)m.Porcentaje);
                        <tr>
                            <td><strong>@m.Metodo</strong></td>
                            <td>@m.Pagos</td>
                            <td>S/ @m.Monto.ToString("N2", inv)</td>
                            <td>
                                <div class="celda-barra">
                                    <div class="pbar"><i style="width:@(w)%"></i></div>
                                    <span>@m.Porcentaje.ToString("0", inv)%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card tabla">
            <table>
                <thead><tr><th>FECHA</th><th>PAGOS</th><th>MONTO</th></tr></thead>
                <tbody>
                    @foreach (var d in Model.PorDia)
                    {
                        <tr>
                            <td>@d.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@d.Pagos</td>
                            <td>S/ @d.Monto.ToString("N2", inv)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <p class="nota-rep">Los pagos se agrupan por su fecha de registro, no por las fechas de la estadía.</p>
}