@using CapaPresentacion.Helpers
@{
    var s = Session["Usuario"] as CapaNegocio.SesionUsuario;
    var ctl = (string)ViewContext.RouteData.Values["controller"];
    var act = (string)ViewContext.RouteData.Values["action"];
    var items = MenuHelper.Para(s != null ? s.Rol : null);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Titulo · Las Terrazas</title>
    <link href="~/Content/hotel.css" rel="stylesheet" />
</head>
<body>
    <div class="app">
        <aside class="side">
            <div class="logo">LT<span><b>LAS TERRAZAS</b><small>HOTEL · AREQUIPA</small></span></div>
            @if (s != null)
            {
                <div class="lbl">@s.Rol.ToUpper()</div>
            }
            <nav>
                @foreach (var it in items)
                {
                    if (it.Listo)
                    {
                        bool activo = it.Controlador == ctl && (it.Accion == act || ctl == "Reportes");
                        <a class="@(activo ? "on" : "")" href="@Url.Action(it.Accion, it.Controlador)">@it.Texto</a>
                    }
                    else
                    {
                        <span class="pronto">@it.Texto <em>pronto</em></span>
                    }
                }
            </nav>
            @if (s != null)
            {
                <div class="who">
                    <strong>@s.NombreMostrar</strong>
                    @s.Rol<br />
                    <a href="@Url.Action("Logout", "Cuenta")">Cerrar sesión</a>
                </div>
            }
        </aside>

        <main class="main">
            @if (TempData["Ok"] != null)
            {
                <div class="ok">@TempData["Ok"]</div>
            }

            @if (TempData["Aviso"] != null)
            {
                <div class="error">@TempData["Aviso"]</div>
            }
            @RenderBody()
        </main>
    </div>
    @RenderSection("scripts", required: false)
</body>
</html>